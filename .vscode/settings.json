{
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "[ ]",
        "[x]",
        "DOCUMENT",
        "PROBLEM",
        "WRITE"
    ],
    "todo-tree.highlights.foregroundColourScheme": [
        "white",
        "black",
        "black",
        "white",
        "white",
        "white",
        "green",
        "red",
        "grey"
    ],
    "todo-tree.highlights.highlightDelay": 250,
    "todo-tree.general.showActivityBarBadge": true,
    "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
    "todo-tree.general.statusBar": "tags",
    "todo-tree.general.statusBarClickBehaviour": "reveal",

    "todo-tree.highlights.customHighlight": {

        "BUG": {
            "icon": "bug",
            "background": "red",
            "foreground": "black",
            "borderRadius": "0"
        },
        "HACK": {
            "icon": "tools",
            "background": "purple",
            "foreground": "grey",
            "borderRadius": "0"
        },
        "FIXME": {
            "icon": "flame",
            "background": "gold",
            "foreground": "red",
            "borderRadius": "0"
        },
        "[ ]": {
            "icon": "issue-draft",
            "borderRadius": "0"
        },
        "[x]": {
            "icon": "issue-closed",
            "borderRadius": "0"
        },
        "DOCUMENT": {
            "icon": "book",
            "foreground": "grey",
            "fontStyle": "italic",
            "borderRadius": "0"
        },
        "PROBLEM": {
            "icon": "question",
            "foreground": "red",
            "borderRadius": "0"
        },
        "WRITE": {
            "icon": "log",
            "foreground": "white",
            "fontStyle": "italic",
            "borderRadius": "0"
        }
    },
    "todo-tree.ripgrep.ripgrepMaxBuffer": 500,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/.venv": true,
        ".venv": true,
        ".gitignore": true,
        ".vscode": false,
        "__init__.py": true,
        "**/__init__.py": true,
        "__pycache__": true,
        "**/__pycache__": true
    },
    "explorerExclude.backup": {},
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.typeEvaluation.analyzeUnannotatedFunctions": false,
    "editor.tabCompletion": "on",
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.editor.tabSizing": "fixed",
    "window.density.editorTabHeight": "compact",
    "notebook.cellFocusIndicator": "border",
    "notebook.cellToolbarVisibility": "hover",
    "editor.formatOnPaste": true,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.autoImportCompletions": true,
    "python.testing.pytestArgs": [
        "tests",
        "append"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
}